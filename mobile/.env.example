# Mobile app configuration. Copy to `.env` (never commit .env).
# EXPO_PUBLIC_ values are embedded in the app bundle - NEVER put secrets here.

# Backend API base URL, including /api/v1.
# Development: leave empty - the app uses the computer running `npx expo start`
#              (same Wi-Fi as the phone) on port 3000 automatically.
# Preview/production builds: REQUIRED, e.g. https://your-api.onrender.com/api/v1
EXPO_PUBLIC_API_URL=
