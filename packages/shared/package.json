{
  "name": "@cc/shared",
  "version": "0.1.0",
  "private": true,
  "description": "Code shared by backend and mobile: enums, zod schemas, order state machine, money helpers.",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "lint": "oxlint src/",
    "test": "vitest run"
  },
  "dependencies": {
    "zod": "^4.1.0"
  },
  "devDependencies": {
    "oxlint": "^1.58.0",
    "typescript": "~6.0.2",
    "vitest": "^4.1.2"
  }
}
