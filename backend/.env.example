# -----------------------------------------------------------------------------
# Backend environment variables. Copy to `.env` (never commit .env).
# Every variable is validated at startup by src/config/env.ts; the server will
# refuse to start and list what is wrong. Docs: docs/ARCHITECTURE.md section 11.
# -----------------------------------------------------------------------------

NODE_ENV=development
PORT=3000
# fatal | error | warn | log | debug | verbose
LOG_LEVEL=log
# true in production (one JSON object per log line)
LOG_JSON=false

# --- Database ---
# Local Docker Postgres (npm run db:up) listens on host port 5433.
# For Supabase use:
#   DATABASE_URL = pooled connection string from the Supabase dashboard
#                  (exact pooler settings for Prisma 7 + adapter-pg are verified in T10.1)
#   DIRECT_URL   = direct connection string - used by migrations
DATABASE_URL=postgresql://cc:cc_local_dev_only@localhost:5433/campusconnect
DIRECT_URL=postgresql://cc:cc_local_dev_only@localhost:5433/campusconnect

# --- HTTP ---
# Comma-separated browser origins allowed by CORS (leave empty for mobile-only)
CORS_ORIGINS=
# Default requests per minute per IP for every endpoint
RATE_LIMIT_PER_MINUTE=120

# --- Auth (docs/DECISIONS.md ADR-017) ---
# Two DIFFERENT random secrets, at least 32 characters each. Generate with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
# The placeholders below work locally; production refuses to start with them.
JWT_ACCESS_SECRET=dev-only-change-me-access-secret-0123456789
CODE_HASH_SECRET=dev-only-change-me-code-secret-9876543210ab
ACCESS_TOKEN_TTL_MINUTES=15
REFRESH_TOKEN_TTL_DAYS=30
# Per-IP requests per minute on signup/login/refresh/password-reset/resend-code
AUTH_RATE_LIMIT_PER_MINUTE=10

# --- Email ---
# console = print emails (incl. verification codes) to the server log. Dev/test only.
MAIL_DRIVER=console

# --- Image storage (docs/DECISIONS.md ADR-019) ---
# local    = files saved in STORAGE_LOCAL_DIR and served by this API (dev only)
# supabase = Supabase Storage; needs the three SUPABASE/STORAGE variables below
STORAGE_DRIVER=local
STORAGE_LOCAL_DIR=.uploads
# SUPABASE_URL=https://<project-ref>.supabase.co
# SUPABASE_SERVICE_ROLE_KEY=   (server only - never in the app)
# STORAGE_BUCKET=media

# --- Payments (docs/DECISIONS.md ADR-004, ADR-024) - TEST MODE ONLY ---
# fake     = built-in fake checkout page (dev/tests)
# razorpay = Razorpay test mode; keys from dashboard.razorpay.com (Test Mode) - rzp_test_ keys only
PAYMENT_GATEWAY=fake
# RAZORPAY_KEY_ID=rzp_test_xxxxxxxxxxxx
# RAZORPAY_KEY_SECRET=
# RAZORPAY_WEBHOOK_SECRET=
# Public https URL of this API, used for the "back to the app" page after paying
# PUBLIC_API_URL=https://your-api.onrender.com
