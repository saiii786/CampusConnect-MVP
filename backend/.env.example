# -----------------------------------------------------------------------------
# Backend environment variables. Copy to `.env` (never commit .env).
# Every variable is validated at startup by src/config/env.ts; the server will
# refuse to start and list what is wrong. Docs: docs/ARCHITECTURE.md section 11.
# -----------------------------------------------------------------------------

NODE_ENV=development
PORT=3000
# fatal | error | warn | log | debug | verbose
LOG_LEVEL=log
# true in production (one JSON object per log line)
LOG_JSON=false

# --- Database ---
# Local Docker Postgres (npm run db:up) listens on host port 5433.
# For Supabase use:
#   DATABASE_URL = pooled connection string from the Supabase dashboard
#                  (exact pooler settings for Prisma 7 + adapter-pg are verified in T10.1)
#   DIRECT_URL   = direct connection string - used by migrations
DATABASE_URL=postgresql://cc:cc_local_dev_only@localhost:5433/campusconnect
DIRECT_URL=postgresql://cc:cc_local_dev_only@localhost:5433/campusconnect

# --- HTTP ---
# Comma-separated browser origins allowed by CORS (leave empty for mobile-only)
CORS_ORIGINS=
# Default requests per minute per IP for every endpoint
RATE_LIMIT_PER_MINUTE=120
